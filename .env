# .env is better suited for public variables, ie, variables that should not commited
# For secret variables is better to use DevServerControl tool with set_env_variable: ["KEY", "SECRET"]

# https://www.builder.io/c/docs/using-your-api-key
VITE_PUBLIC_BUILDER_KEY=__BUILDER_PUBLIC_KEY__
PING_MESSAGE="ping pong"

# Configuración de Email (SMTP)
# Ejemplo para Gmail: smtp.gmail.com, puerto 587
# Nota: Para Gmail necesitas una "Contraseña de Aplicación" si tienes 2FA activado

# Servidor de correo saliente de tu proveedor
SMTP_HOST=smtp.gmail.com
# 587 (STARTTLS) o 465 (TLS directo). Por defecto 587.
SMTP_PORT=587
# La cuenta desde la que sale el correo
SMTP_USER=notificacionesingetech@gmail.com
# Contraseña de esa cuenta. Con Gmail: contraseña de aplicación, no la normal.
SMTP_PASS=zxoc wkhi ylkp ycqh
# A dónde llegan los mensajes del formulario. Si lo dejas vacío, usa SMTP_USER.
CONTACT_EMAIL=ventas@ingetech-elevators.com

