# Copia este archivo como .env.local y rellena los valores.
# .env.local está ignorado por git (patrón *.local), así que las credenciales
# NO se suben al repositorio. No pongas nada de esto en .env, que sí está
# versionado.
#
# En producción, define estas mismas variables en Vercel:
#   Project Settings -> Environment Variables

# Servidor de correo saliente de tu proveedor
SMTP_HOST=
# 587 (STARTTLS) o 465 (TLS directo). Por defecto 587.
SMTP_PORT=587
# La cuenta desde la que sale el correo
SMTP_USER=
# Contraseña de esa cuenta. Con Gmail: contraseña de aplicación, no la normal.
SMTP_PASS=
# A dónde llegan los mensajes del formulario. Si lo dejas vacío, usa SMTP_USER.
CONTACT_EMAIL=
