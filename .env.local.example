# Copia este archivo como .env.local y rellena los valores.
# .env.local está ignorado por git (patrón *.local), así que las credenciales
# NO se suben al repositorio. No pongas nada de esto en .env, que sí está
# versionado.
#
# En producción, define estas mismas variables en Vercel:
#   Project Settings -> Environment Variables

# Clave de la API de correo (cabecera x-api-key). SECRETA.
EMAIL_API_KEY=

# A dónde llegan los mensajes del formulario.
CONTACT_EMAIL=

# Opcional: solo si algún día cambia el endpoint de la API de correo.
# Por defecto: https://bot-template.unify-tc.com/api/email/send
# EMAIL_API_URL=
